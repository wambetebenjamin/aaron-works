# ---------------------------------------------------------------------------
# Aaron Works — environment variables
# Copy to .env.local (development) or add to your Vercel project (production).
# Every value below is optional for a local demo: the app falls back to seed
# data, a development auth secret, and skips CAPTCHA/SMTP/Blob when unset.
# ---------------------------------------------------------------------------

# Public site URL used for metadata, Open Graph, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://aaronworks.co.ke

# WhatsApp number in international format, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# --- Google reCAPTCHA v3 (invisible) ---------------------------------------
# Create keys at https://www.google.com/recaptcha/admin (score-based v3 site).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key

# --- Auth ------------------------------------------------------------------
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is accepted for compatibility.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
# NextAuth v5 checks AUTH_SECRET first; set it as an alias if you prefer the
# newer name. At least one of the two must be set in production.
# AUTH_SECRET=replace-with-the-same-long-random-string
NEXTAUTH_URL=https://aaronworks.co.ke

# Google OAuth (optional). The "Continue with Google" buttons stay disabled
# until both values are present.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Images ----------------------------------------------------------------
# Server-side only. Not required: the curated images are committed in
# /public/images. Used by any build-time fetch script.
PEXELS_API_KEY=your-pexels-api-key

# --- Vercel KV (optional persistence) --------------------------------------
# Without these the app uses an in-memory store (dev mirror: data/runtime.json).
KV_REST_API_URL=https://your-project.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-rest-api-token

# --- Vercel Blob (job attachments) -----------------------------------------
# Without this, /api/upload returns 503 and jobs can be posted without files.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# --- SMTP (contact form delivery via nodemailer) ---------------------------
# Without a complete set, /api/contact still stores the message and returns
# "stored for the support team" instead of sending email.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=hello@aaronworks.co.ke
SMTP_PASS=your-smtp-password
SMTP_FROM="Aaron Works <hello@aaronworks.co.ke>"
